@inject CurrentActor Actor
@inject Microsoft.Extensions.Options.IOptions<ReviewOptions> ReviewOptions
@{
    var path = Context.Request.Path.Value ?? "/";
    var review = ReviewOptions.Value;
    var here = path + Context.Request.QueryString;
    string Active(string prefix) => path.Equals(prefix, StringComparison.OrdinalIgnoreCase)
        || (prefix != "/" && path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) ? "is-active" : string.Empty;
}
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string title ? title + " — RCS" : "RCS")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(ViewData["Workspace"] is true ? "workspace-page" : "standard-page")">
    <a class="skip-link" href="#main">@T["Shell.Skip"]</a>
    <header>
        <div class="topbar">
            <a class="topbar__name" href="/" title="@T["App.Name"]"><span class="brand-mark" aria-hidden="true">R</span> RCS</a>
            <div class="breadcrumb"><a href="@(path.StartsWith("/organizations", StringComparison.OrdinalIgnoreCase) ? "/organizations" : "/cases")">@(path.StartsWith("/organizations", StringComparison.OrdinalIgnoreCase) ? T["Nav.Organizations"] : T["Nav.Cases"])</a><span aria-hidden="true">/</span><strong>@ViewData["Title"]</strong></div>
            <a class="shell-search" href="/cases#list-search"><span aria-hidden="true">⌕</span> @T["Shell.Search"]</a>
            <div class="topbar__actor">
                @if (Actor.IsAvailable)
                {
                    <text>@T["App.Actor"]: <strong>@Actor.Require.DisplayName</strong> · @string.Join(" / ", Actor.Require.Roles.Select(role => role.ToCode()))</text>
                }
            </div>
        </div>
        <div class="banner">
            <span class="banner__title">@T["App.Banner"]</span>
            <span class="banner__note"> — @T["App.BannerNote"]</span>
            @if (Actor.IsAvailable)
            {
                @* Development-only identity switch, so the Head's own acts can be reviewed as the Head (ADR-040). *@
                @* An explicit action suppresses the automatic antiforgery field, so it is asked for by name. *@
                <form class="banner__switch" method="post" action="/review/actor" asp-antiforgery="true">
                    <input type="hidden" name="returnUrl" value="@here" />
                    <span class="banner__note">@T["App.ActAs"]:</span>
                    <button class="btn btn--small" type="submit" name="username" value="@review.ActorUsername">@T["App.ActAs.Chief"]</button>
                    <button class="btn btn--small" type="submit" name="username" value="@review.HeadUsername">@T["App.ActAs.Head"]</button>
                </form>
            }
        </div>
        <nav class="nav" aria-label="@T["Shell.Navigation"]">
            <div class="nav-caption">@T["Shell.Workspace"]</div>
            <a class="@Active("/")" href="/"><span class="nav-icon" aria-hidden="true">⌂</span>@T["Nav.Home"]</a>
            <a class="@Active("/cases")" href="/cases"><span class="nav-icon" aria-hidden="true">▤</span>@T["Nav.Cases"]</a>
            <a class="@Active("/organizations")" href="/organizations"><span class="nav-icon" aria-hidden="true">▥</span>@T["Nav.Organizations"]</a>
        <div class="nav-bottom"><span class="status-dot tone-positive"></span>@T["Shell.Local"]<small>@T["Shell.Review"]</small></div></nav>
    </header>
    <main id="main">
        @if (!Actor.IsAvailable)
        {
            <div class="card">
                <h1>@T["App.NoActor.Title"]</h1>
                <p>@T["App.NoActor.Body"]</p>
            </div>
        }
        else
        {
            @RenderBody()
        }
    </main>
    <footer>@T["App.Footer"]</footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/workspace.js" asp-append-version="true"></script>
</body>
</html>
