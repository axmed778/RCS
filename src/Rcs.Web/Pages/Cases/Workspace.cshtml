@page "/cases/{caseId:guid}"
@model Rcs.Web.Pages.Cases.WorkspaceModel
@{
    var workspace = Model.Workspace;
    ViewData["Workspace"] = true;
    ViewData["Title"] = workspace is null ? T["Cases.Title"].Value : workspace.Header.CaseNumber;
}

@if (workspace is not null)
{
    var header = workspace.Header;
    var progress = workspace.Progress;

    @if (Model.ActionError is { Length: > 0 } actionError)
    {
        <div class="alert"><strong>@T["Error.Title"]</strong> — @actionError</div>
    }

    <div class="page-head">
        <div>
            <h1>@header.Title</h1>
            <p class="mono">@header.CaseNumber</p>
        </div>
        <div class="actions">
            <a class="btn" href="/cases">@T["Common.Back"]</a>
            @if (AuthorizationPolicy.Decide(workspace.Actor, BusinessAction.RegisterOutgoingRequest, workspace.Relationship).IsAllowed)
            {
                <a class="btn btn--primary" href="/cases/@header.Id/requests/new">@T["Workspace.AddRequest"]</a>
            }
        </div>
    </div>

    <div class="workspace-summary"><span class="status-dot"></span><strong>@T.Progress(progress.Headline)</strong><span>@T.Summary(progress.Summary)</span></div>
    <div data-workspace data-collapse="@T["Graph.Collapse"]" data-expand="@T["Graph.Expand"]" data-related="@T["Graph.Related"]" data-case-id="@header.Id">
    <div class="workspace-tools" hidden>
        <div><span class="tool-icon" aria-hidden="true">⑂</span><strong>@T["Workspace.Workflow"]</strong><span class="tool-note">@T["Graph.ReadOnly"]</span></div>
        <div class="graph-controls"><button type="button" class="btn" data-zoom="out" aria-label="@T["Graph.ZoomOut"]">−</button><output data-zoom-value>100%</output><button type="button" class="btn" data-zoom="in" aria-label="@T["Graph.ZoomIn"]">+</button><button type="button" class="btn" data-zoom="fit">@T["Graph.Fit"]</button><button type="button" class="btn" data-zoom="reset">1:1</button></div>
    </div>
    <div class="workspace-body">
    <section class="canvas" aria-label="@T["Workspace.Workflow"]" hidden><div class="graph-viewport"><div class="graph-stage"></div></div><div class="graph-legend">
        <span><i class="status-dot tone-positive"></i>@T["Graph.Positive"]</span><span><i class="status-dot tone-conditional"></i>@T["Graph.Conditional"]</span><span><i class="status-dot tone-negative"></i>@T["Graph.Negative"]</span><span><i class="status-dot tone-waiting"></i>@T["Graph.Waiting"]</span>
    </div></section>
    <aside class="inspector" aria-label="@T["Graph.Inspector"]" hidden>
        <div class="inspector-heading"><span class="inspector-icon" aria-hidden="true">▤</span><div><div class="eyebrow" data-inspector-type></div><h2 data-inspector-title></h2></div></div>
        <div class="inspector-tabs"><button type="button" class="is-active" data-inspector-tab="details" aria-pressed="true">@T["Graph.Details"]</button><button type="button" data-inspector-tab="history" aria-pressed="false">@T["Graph.History"] <span data-history-count></span></button></div>
        <div class="inspector-content" data-inspector-details></div><div class="inspector-content" data-inspector-history hidden></div>
    </aside>
    <div class="workspace-source">
    <div class="card" id="case-@header.Id" data-graph-node data-kind="case" data-entity="@header.Id" data-title="@header.CaseNumber" data-label="@T["Workspace.Header.Case"]" data-meta="@header.Title" data-status="@T.CaseState(header.State)" data-tone="case">
        <dl class="facts">
            <div><dt>@T["Workspace.Header.Case"]</dt><dd class="mono">@header.CaseNumber</dd></div>
            <div><dt>@T["Workspace.Header.Requester"]</dt><dd>@header.RequestingOrganization.Name</dd></div>
            <div><dt>@T["Workspace.Header.Responsible"]</dt><dd>@(header.Responsible?.DisplayName ?? T["Cases.Unassigned"].Value)</dd></div>
            <div><dt>@T["Workspace.Header.State"]</dt><dd><span class="badge">@T.CaseState(header.State)</span></dd></div>
            <div><dt>@T["Workspace.Header.Registered"]</dt><dd class="mono">@T.Date(header.RegisteredAt)</dd></div>
        </dl>
        <div style="margin-top:1rem">
            <div class="headline @T.ProgressModifier(progress.Headline)">@T.Progress(progress.Headline)</div>
            <div class="summary-line">@T.Summary(progress.Summary)</div>
        </div>
        @if (header.Subject is { Length: > 0 } subject)
        {
            <p class="node__meta" style="margin-top:.75rem">@subject</p>
        }
        @if (header.Notes is { Length: > 0 } notes)
        {
            <p class="node__meta"><strong>@T["Workspace.Notes"]:</strong> @notes</p>
        }
    </div>

    <div class="section-title">@T["Workspace.OriginalLetter"]</div>
    @if (workspace.InitiatingLetter is { } letter)
    {
        <div class="node node--letter" id="letter-@letter.Id" data-graph-node data-kind="letter" data-entity="@letter.Id" data-title="@T.Text(letter.LetterNumber)" data-label="@T["Workspace.OriginalLetter"]" data-meta="@letter.Sender.Name · @T.Date(letter.LetterDate)" data-status="@T.Code("CorrespondenceStatus", "RECEIVED")" data-tone="waiting">
            <div class="node__head">
                <div>
                    <div class="node__title mono">@T.Text(letter.LetterNumber) · @T.Date(letter.LetterDate)</div>
                </div>
                <span class="badge">@T.Date(letter.ReceivedAt)</span>
            </div>
            <dl class="facts" style="margin-top:.6rem">
                <div><dt>@T["Letter.Sender"]</dt><dd>@letter.Sender.Name</dd></div>
                <div><dt>@T["Letter.Recipient"]</dt><dd>@letter.Recipient.Name</dd></div>
                <div><dt>@T["Letter.RegistryNumber"]</dt><dd class="mono">@T.Text(letter.RegistryNumber)</dd></div>
                <div><dt>@T["Letter.Received"]</dt><dd class="mono">@T.Date(letter.ReceivedAt)</dd></div>
                <div><dt>@T["Letter.Registered"]</dt><dd>@T.DateTime(letter.RegisteredAt) · @letter.RegisteredBy.DisplayName</dd></div>
            </dl>
            @if (letter.Subject is { Length: > 0 } letterSubject)
            {
                <p class="node__meta">@letterSubject</p>
            }
        </div>
    }

    <div class="section-title">@T["Workspace.Workflow"]</div>
    @if (workspace.TopLevelRequests.Count == 0)
    {
        <div class="card"><div class="empty">@T["Workspace.NoRequests"]</div></div>
    }
    else
    {
        <ul class="tree" data-root-requests>
            @foreach (var request in workspace.TopLevelRequests)
            {
                <li>
                    @{
                        var branch = workspace.Progress.Branches.TryGetValue(request.Id, out var branchProgress) ? branchProgress : null;
                    }
                    @if (branch is not null)
                    {
                        <div class="node__label" style="margin-bottom:.3rem">
                            @T["Workspace.Branch"]: @T.BranchState(branch.State)
                            @if (branch.Headline is { } branchHeadline)
                            {
                                <text>· @T.Progress(branchHeadline)</text>
                            }
                        </div>
                    }
                    <partial name="_RequestNode" model="new RequestNodeView(request, workspace)" />
                </li>
            }
        </ul>
    }

    <div class="section-title">@T["Workspace.Activity"]</div>
    <div class="card">
        @if (workspace.Activity.Count == 0)
        {
            <div class="empty">@T["Workspace.NoActivity"]</div>
        }
        else
        {
            <ul class="activity" data-case-activity>
                @foreach (var entry in workspace.Activity)
                {
                    <li data-entity="@entry.EntityId">
                        <span class="activity__when mono">@T.DateTime(entry.RecordedAt)</span>
                        <span class="activity__what">@T.Code("ActionCode", entry.ActionCode) — @T.Code("EntityType", entry.EntityType)</span>
                        @if (entry.Detail is { Length: > 0 } detail)
                        {
                            <span class="mono">@detail</span>
                        }
                        @if (entry.Status is { Length: > 0 } status)
                        {
                            <span class="badge badge--plain">@T.ActivityStatus(entry.EntityType, status)</span>
                        }
                        <span class="activity__who">
                            @(entry.ActorDisplayName ?? T["ActorKind.JOB"].Value)
                            @if (entry.ActorKind != ActorKind.User)
                            {
                                <text>(@T.Code("ActorKind", entry.ActorKind.ToCode()))</text>
                            }
                        </span>
                        @if (entry.ReasonNote is { Length: > 0 } reason)
                        {
                            <span class="node__meta">@reason</span>
                        }
                    </li>
                }
            </ul>
        }
    </div>
    </div>
    </div>
    </div>
}
