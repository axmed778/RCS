@page "/cases/{caseId:guid}/requests/new"
@model Rcs.Web.Pages.Cases.RequestNewModel
@{
    ViewData["Title"] = T["RequestNew.Title"].Value;
}

<div class="page-head">
    <div>
        <h1>@T["RequestNew.Title"]</h1>
        <p class="intro">@T["RequestNew.Intro"]</p>
        @if (Model.SourceRequirement is { } source)
        {
            <p class="intro"><strong>@T.Format("RequestNew.Child", source.Title)</strong></p>
        }
    </div>
    <a class="btn" href="/cases/@Model.CaseId">@T["Common.Back"]</a>
</div>

<form class="form card" method="post" data-single-submit>
    <div asp-validation-summary="ModelOnly" class="alert"></div>
    <input type="hidden" asp-for="Input.OperationId" />

    <div class="field">
        <label asp-for="Input.TargetOrganizationId">@T["Field.TargetOrganization"]</label>
        <select asp-for="Input.TargetOrganizationId">
            <option value="">@T["Common.Select"]</option>
            @foreach (var organization in Model.Organizations)
            {
                <option value="@organization.Id">@organization.Name</option>
            }
        </select>
        <span asp-validation-for="Input.TargetOrganizationId" class="form-error"></span>
    </div>

    <div class="field">
        <label asp-for="Input.Subject">@T["Field.RequestSubject"]</label>
        <input asp-for="Input.Subject" type="text" maxlength="200" />
        <span asp-validation-for="Input.Subject" class="form-error"></span>
    </div>

    <div class="field-row">
        <div class="field">
            <label asp-for="Input.OutgoingLetterNumber">@T["Field.OutgoingLetterNumber"]</label>
            <input asp-for="Input.OutgoingLetterNumber" type="text" maxlength="80" />
            <div class="hint">@T["RequestNew.SameLetter"]</div>
            <span asp-validation-for="Input.OutgoingLetterNumber" class="form-error"></span>
        </div>
        <div class="field">
            <label asp-for="Input.SentDate">@T["Field.SentDate"]</label>
            <input asp-for="Input.SentDate" type="date" data-deadline-from />
            <span asp-validation-for="Input.SentDate" class="form-error"></span>
        </div>
    </div>

    <div class="field">
        <label asp-for="Input.DueDate">@T["Field.DueDate"]</label>
        <input asp-for="Input.DueDate" type="date" data-deadline-to data-deadline-days="@Rcs.Web.Pages.Cases.RequestNewModel.DeadlineDays" />
        <div class="hint">@T.Format("RequestNew.DeadlineHint", Rcs.Web.Pages.Cases.RequestNewModel.DeadlineDays)</div>
        <span asp-validation-for="Input.DueDate" class="form-error"></span>
    </div>

    <div class="field">
        <label asp-for="Input.RequestedItemsNote">@T["Field.RequestedItems"] <span class="hint">(@T["Common.Optional"])</span></label>
        <textarea asp-for="Input.RequestedItemsNote" maxlength="2000"></textarea>
    </div>

    <div class="actions">
        <button class="btn btn--primary" type="submit">@T["Action.Register"]</button>
        <a class="btn" href="/cases/@Model.CaseId">@T["Action.Cancel"]</a>
    </div>
</form>
