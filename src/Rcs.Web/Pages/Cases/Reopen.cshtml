@page "/cases/{caseId:guid}/reopen"
@model Rcs.Web.Pages.Cases.ReopenModel
@{
    ViewData["Title"] = T["Reopen.Title"].Value;
}

<div class="page-head">
    <div>
        <h1>@T["Reopen.Title"]</h1>
        <p class="intro">@T["Reopen.Intro"]</p>
    </div>
    <a class="btn" href="/cases/@Model.CaseId">@T["Common.Back"]</a>
</div>

<div class="card">
    <ul class="guide">
        <li>@T["Reopen.SameCase"]</li>
        <li>@T["Reopen.KeepsClosure"]</li>
        <li>@T["Reopen.KeepsResult"]</li>
    </ul>
</div>

<form class="form card" method="post" data-single-submit>
    <div asp-validation-summary="ModelOnly" class="alert"></div>
    <input type="hidden" asp-for="Input.RowVersion" />

    <div class="field">
        <label asp-for="Input.Reason">@T["Field.ReopenReason"]</label>
        <textarea asp-for="Input.Reason" maxlength="2000" required></textarea>
        <span asp-validation-for="Input.Reason" class="form-error"></span>
    </div>

    <div class="actions">
        <button class="btn btn--primary" type="submit">@T["Reopen.Submit"]</button>
        <a class="btn" href="/cases/@Model.CaseId">@T["Action.Cancel"]</a>
    </div>
</form>
