@page "/account/password"
@model Rcs.Web.Pages.Account.PasswordModel
@{
    ViewData["Title"] = T["Auth.ChangePassword"].Value;
    Layout = Model.MustChange ? "_AuthLayout" : "_Layout";
}
<div class="auth-card">
    <h1>@T["Auth.ChangePassword"]</h1>
    @if (Model.MustChange)
    {
        <div class="alert" role="alert">@T["Auth.MustChangePassword"]</div>
    }
    @if (Model.Notice is { Length: > 0 } notice)
    {
        <div class="alert">@notice</div>
    }
    <p class="hint">@T.Format("Auth.PasswordRule", Rcs.Domain.Identity.PasswordPolicy.MinimumLength)</p>
    <form method="post" class="form" data-single-submit>
        <div asp-validation-summary="All" class="alert" role="alert"></div>
        <div class="field">
            <label for="current">@T["Auth.CurrentPassword"]</label>
            <input id="current" name="currentPassword" type="password" autocomplete="current-password" required maxlength="128" />
        </div>
        <div class="field">
            <label for="next">@T["Auth.NewPassword"]</label>
            <input id="next" name="newPassword" type="password" autocomplete="new-password" required minlength="@Rcs.Domain.Identity.PasswordPolicy.MinimumLength" maxlength="128" />
        </div>
        <div class="field">
            <label for="repeat">@T["Auth.RepeatPassword"]</label>
            <input id="repeat" name="repeatPassword" type="password" autocomplete="new-password" required maxlength="128" />
        </div>
        <div class="actions">
            <button class="btn btn--primary" type="submit">@T["Auth.ChangePassword"]</button>
            @if (!Model.MustChange)
            {
                <a class="btn" href="/">@T["Common.Back"]</a>
            }
        </div>
    </form>
</div>
