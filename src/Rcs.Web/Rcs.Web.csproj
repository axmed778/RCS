<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    ASP.NET Core host and composition root. Phase 1: technical endpoints and deployment commands only.
    No business UI. Server-rendered pages arrive in later phases (DECISIONS.md ADR-003).
  -->
  <PropertyGroup>
    <RootNamespace>Rcs.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rcs.Application\Rcs.Application.csproj" />
    <ProjectReference Include="..\Rcs.Infrastructure\Rcs.Infrastructure.csproj" />
    <ProjectReference Include="..\Rcs.PreviewWorker\Rcs.PreviewWorker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The CLI commands read configuration from the application directory, so it must be in the output. -->
    <Content Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyPreviewWorker" AfterTargets="Build">
    <ItemGroup>
      <PreviewWorkerFiles Include="../Rcs.PreviewWorker/bin/$(Configuration)/$(TargetFramework)/*" />
    </ItemGroup>
    <Copy SourceFiles="@(PreviewWorkerFiles)" DestinationFolder="$(OutDir)preview-worker" SkipUnchangedFiles="true" />
  </Target>
  <!--
    The preview worker is Linux-only: its converters (poppler, libvips, LibreOffice) and its bubblewrap sandbox do
    not exist on Windows, and the Windows single-laptop pilot runs with previews switched off. Publishing it into a
    Windows package would ship ~40 MB of code that can never run there.
  -->
  <Target Name="PublishPreviewWorker" AfterTargets="Publish" Condition="!$(RuntimeIdentifier.StartsWith('win'))">
    <MSBuild Projects="../Rcs.PreviewWorker/Rcs.PreviewWorker.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(PublishDir)preview-worker/" />
  </Target>
</Project>
