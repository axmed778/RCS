{
  "Urls": "http://127.0.0.1:5000",
  "AllowedHosts": "cases.internal.example",
  "Rcs": {
    "Preview": {
      "Enabled": false,
      "StorageRoot": "/srv/rcs/previews",
      "TempRoot": "/srv/rcs/preview-tmp",
      "WorkerConcurrency": 1,
      "JobTimeoutSeconds": 240,
      "Sandbox": { "Mode": "Bubblewrap" }
    },
    "Storage": {
      "RootPath": "/srv/rcs/objects",
      "TempPath": "/srv/rcs/tmp-uploads",
      "VolumeCode": "PRIMARY",
      "MaxUploadBytes": 524288000,
      "TemporaryRetentionHours": 24
    },
    "Hosting": {
      "BaseUrl": "https://cases.internal.example"
    }
  }
}
