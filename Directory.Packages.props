<Project>
  <!--
    Central, exact package versions. Every addition needs a reason: the stack must stay rebuildable
    offline for years (ARCHITECTURE.md §16, SECURITY.md §18.1).
    Deliberately absent: any ORM migration generator (DECISIONS.md ADR-004), Redis, brokers,
    search engines, cloud SDKs.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Runtime">
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!--
      Argon2id password hashing (ADR-033, SECURITY.md §6.2). .NET ships no memory-hard password hash, and writing
      one would be exactly the custom cryptography this repository refuses. Pure managed, no native assets, MIT,
      the managed Blake2 dependency is pinned transitively in package lock files. Restore offline from a prepared cache.
    -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>
</Project>
