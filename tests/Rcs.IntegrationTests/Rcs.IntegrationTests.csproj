<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests against a REAL PostgreSQL 17+ server; nothing about schema behaviour is mocked.
    Requires RCS_TEST_ADMIN_CONNECTION (see README.md). Each test creates and drops its own database.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Rcs.IntegrationTests</RootNamespace>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rcs.Infrastructure\Rcs.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Rcs.Web\Rcs.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
